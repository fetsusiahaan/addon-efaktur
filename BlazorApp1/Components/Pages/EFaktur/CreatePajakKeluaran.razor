@page "/efaktur/create-pajak-keluaran"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,User")]
@using BlazorApp1.Models
@using BlazorApp1.Services
@using Radzen.Blazor
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject PajakKeluaranService FpService
@inject WebDbService WebDb
@inject NavigationManager Nav
@inject Radzen.DialogService DialogService
@inject Radzen.NotificationService Notifications

<PageTitle>Buat Pajak Keluaran</PageTitle>

<div class="ef-page">

    <PageHeader Title="Buat Pajak Keluaran" Breadcrumb="E-Faktur › Pajak Keluaran">
        <Actions>
            <button type="button" class="btn ef-btn-ghost" @onclick='() => Nav.NavigateTo("/efaktur/pajak-keluaran")'>
                <i class="bi bi-arrow-left me-1"></i> Kembali ke Daftar
            </button>
        </Actions>
    </PageHeader>

    @* ---------- Panel Filter ---------- *@
    <div class="ef-card ef-filter mb-3">
        <div class="row g-3">

            @* ===== Kolom kiri: field filter ===== *@
            <div class="col-md-8">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="ef-label">Search by</label>
                        <select class="form-select" @bind="searchBy">
                            <option>Invoice Number</option>
                            <option>Date</option>
                            <option>Customer</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="ef-label">Document Number</label>
                        <div class="input-group">
                            <input class="form-control" value="@docNumber" readonly placeholder="No. Faktur otomatis..." />
                            <button class="btn ef-btn-ghost" type="button" @onclick="GenerateNoFaktur" title="Generate ulang No. Faktur">
                                <i class="bi bi-arrow-repeat"></i>
                            </button>
                        </div>
                    </div>

                    @if (searchBy == "Invoice Number")
                    {
                        <div class="col-md-6">
                            <label class="ef-label">From Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input class="form-control" placeholder="Pilih invoice..." value="@invFromNum" readonly />
                                <button class="btn ef-btn-ghost" type="button" @onclick="() => OpenInvoiceModal(true)" title="Pilih invoice">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="ef-label">To Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input class="form-control" placeholder="Pilih invoice..." value="@invToNum" readonly />
                                <button class="btn ef-btn-ghost" type="button" @onclick="() => OpenInvoiceModal(false)" title="Pilih invoice">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                    }
                    else if (searchBy == "Date")
                    {
                        <div class="col-md-6">
                            <label class="ef-label">From Date <span class="text-danger">*</span></label>
                            <div class="ef-date-field">
                                <input class="form-control" placeholder="dd.mm.yy" maxlength="8" inputmode="numeric"
                                       value="@fromDate" @oninput="e => fromDate = FormatDateMask(e.Value?.ToString())" />
                                <input type="date" class="ef-date-native" value="@ToIso(fromDate)"
                                       @onchange="e => fromDate = FromIso(e.Value?.ToString())" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="ef-label">To Date <span class="text-danger">*</span></label>
                            <div class="ef-date-field">
                                <input class="form-control" placeholder="dd.mm.yy" maxlength="8" inputmode="numeric"
                                       value="@toDate" @oninput="e => toDate = FormatDateMask(e.Value?.ToString())" />
                                <input type="date" class="ef-date-native" value="@ToIso(toDate)"
                                       @onchange="e => toDate = FromIso(e.Value?.ToString())" />
                            </div>
                        </div>
                    }
                    else if (searchBy == "Customer")
                    {
                        <div class="col-md-6">
                            <label class="ef-label">From Customer <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input class="form-control" placeholder="Pilih customer..." value="@custFromName" readonly />
                                <button class="btn ef-btn-ghost" type="button" @onclick="() => OpenCustomerModal(true)" title="Pilih customer">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="ef-label">To Customer <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input class="form-control" placeholder="Pilih customer..." value="@custToName" readonly />
                                <button class="btn ef-btn-ghost" type="button" @onclick="() => OpenCustomerModal(false)" title="Pilih customer">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                    }

                    <div class="col-md-6">
                        <label class="ef-label">Canceled</label>
                        <input class="form-control" value="No" readonly />
                    </div>
                </div>
            </div>

            @* ===== Kolom kanan: Document Type + Load Data ===== *@
            <div class="col-md-4 d-flex flex-column">
                <label class="ef-label">Document Type</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="dtInvoice" @bind="dtInvoice" />
                    <label class="form-check-label" for="dtInvoice">Invoice</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="dtDownPayment" @bind="dtDownPayment" />
                    <label class="form-check-label" for="dtDownPayment">Down Payment</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="dtRefCreditMemo" @bind="dtRefCreditMemo" />
                    <label class="form-check-label" for="dtRefCreditMemo">Ref Credit Memo</label>
                </div>
                <div class="mt-auto text-end pt-3">
                    <button type="button" class="btn ef-btn-primary" @onclick="LoadData" disabled="@loading">
                        <i class="bi bi-arrow-clockwise me-1"></i> Load Data
                    </button>
                </div>
            </div>

        </div>

        @if (_validationError is not null)
        {
            <div class="alert alert-warning py-2 mb-0 mt-3">
                <i class="bi bi-exclamation-triangle me-1"></i>@_validationError
            </div>
        }
    </div>

    @* ---------- Grid data (dinamis dari hasil query) ---------- *@
    <div class="ef-card ef-grid mb-3">
        @if (loading)
        {
            <div class="text-center text-muted py-5">
                <div class="spinner-border text-secondary" role="status"></div>
                <div class="mt-2">Memuat data...</div>
            </div>
        }
        else if (result?.Error is not null)
        {
            <div class="alert alert-danger m-3 mb-0">
                <strong>Gagal memuat data.</strong><br />
                @result.Error
            </div>
        }
        else if (result is not null)
        {
            <div class="dpk-card-head">
                <span class="dpk-card-title">Hasil Faktur Pajak Keluaran</span>
                <div class="dpk-card-tools">
                    <button type="button" class="dpk-filter-btn @(_showFilter ? "active" : "")"
                            @onclick="() => _showFilter = !_showFilter">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <button type="button" class="dpk-filter-btn" @onclick="LoadData" disabled="@loading" title="Muat ulang">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>

            <RadzenDataGrid Data="@_rows" TItem="FakturKeluaranRow"
                            AllowFiltering="@_showFilter" FilterMode="Radzen.FilterMode.Simple"
                            FilterCaseSensitivity="Radzen.FilterCaseSensitivity.CaseInsensitive"
                            AllowSorting="true" AllowColumnResize="true"
                            AllowAlternatingRows="true" AllowPaging="true" PageSize="10"
                            PagerPosition="Radzen.PagerPosition.Top" PagerHorizontalAlign="Radzen.HorizontalAlign.Right"
                            ShowPagingSummary="true" PagingSummaryFormat="Halaman {0} dari {1} ({2} data)"
                            Density="Radzen.Density.Compact" GridLines="Radzen.DataGridGridLines.Horizontal"
                            EmptyText="Tidak ada data." class="dpk-grid"
                            Style="height: 60vh;">
                <Columns>
                    <RadzenDataGridColumn TItem="FakturKeluaranRow" Width="46px" Sortable="false" Filterable="false"
                                          TextAlign="Radzen.TextAlign.Center">
                        <HeaderTemplate>
                            <input type="checkbox" title="Pilih semua"
                                   checked="@AllSelected"
                                   @onchange="e => ToggleAll((bool)(e.Value ?? false))" />
                        </HeaderTemplate>
                        <Template Context="row">
                            <input type="checkbox" checked="@_selected.Contains(row)"
                                   @onchange="e => ToggleRow(row, (bool)(e.Value ?? false))" />
                        </Template>
                    </RadzenDataGridColumn>
                    @* Kolom dibangkitkan dinamis dari FakturKeluaranRow.Columns
                       (Title dari model, Width menyesuaikan data). *@
                    @foreach (var c in FakturKeluaranRow.Columns)
                    {
                        <RadzenDataGridColumn TItem="FakturKeluaranRow" Property="@c.Property" Title="@c.Title"
                                              Width="@WidthOf(c.Property)" Visible="@c.Visible"
                                              TextAlign="@(c.Kind is ColKind.Number or ColKind.Money ? Radzen.TextAlign.Right : Radzen.TextAlign.Left)"
                                              FormatString="@FormatOf(c.Kind)" />
                    }
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-table" style="font-size:1.6rem"></i>
                <div class="mt-2">Klik Load Data untuk menampilkan data.</div>
            </div>
        }
    </div>

    @* ---------- Bar Aksi ---------- *@
    <div class="ef-actionbar">
        <div class="d-flex gap-2">
            <button type="button" class="btn ef-btn-primary" @onclick="AddData" disabled="@_saving">
                <i class="bi bi-plus-lg me-1"></i> Add
            </button>
            <button type="button" class="btn ef-btn-secondary">Cancel</button>
        </div>
    </div>

</div>

@code {
    private string searchBy = "Customer";
    private string docNumber = "";     // No. Faktur hasil SP generator
    private bool _noFakturLoaded;
    private bool _saving;              // proses Add ke SAP_WEB
    private bool dtInvoice = true;
    private bool dtDownPayment = true;
    private bool dtRefCreditMemo = true;

    // Isian From/To per jenis Search By.
    // Invoice Number: tampil NumAtCard, tapi yang dipakai SP = DocEntry (hidden).
    private string invFromNum = "";   // NumAtCard (tampil)
    private string invFromDoc = "";   // DocEntry (hidden -> param SP)
    private string invToNum = "";
    private string invToDoc = "";
    // Customer: tampil CardName, tapi yang dipakai SP = DocEntry (hidden).
    private string custFromName = "";  // CardName (tampil)
    private string custFromDoc = "";   // DocEntry (hidden -> param SP)
    private string custToName = "";
    private string custToDoc = "";

    private bool loading;
    private bool _showFilter;
    private string? _validationError;
    private QueryResult? result;

    // Hasil SP dipetakan ke model bertipe.
    private List<FakturKeluaranRow> _rows = new();

    // Baris tercentang.
    private readonly HashSet<FakturKeluaranRow> _selected = new();
    private void ToggleRow(FakturKeluaranRow row, bool value)
    {
        if (value) _selected.Add(row); else _selected.Remove(row);
    }

    // Ceklis header = pilih/hapus semua baris.
    private bool AllSelected => _rows.Count > 0 && _selected.Count == _rows.Count;
    private void ToggleAll(bool value)
    {
        if (value) foreach (var r in _rows) _selected.Add(r);
        else _selected.Clear();
    }

    // Generate No. Faktur (Document Number) dari SP saat halaman pertama dibuka.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_noFakturLoaded)
        {
            _noFakturLoaded = true;
            await GenerateNoFaktur();
        }
    }

    private async Task GenerateNoFaktur()
    {
        // Di thread pool agar driver DB yang memblokir tak membekukan UI.
        var no = await Task.Run(() => FpService.GenerateNoFakturAsync());
        docNumber = no ?? "";
        await InvokeAsync(StateHasChanged);
    }

    // ── Add: simpan hasil grid ke SAP_WEB (IDU_PAJAK_TRANS + _DET) ────────────
    private async Task AddData()
    {
        // Hanya baris yang dicentang (urutan grid dipertahankan).
        var chosen = _rows.Where(r => _selected.Contains(r)).ToList();
        if (chosen.Count == 0)
        {
            Notifications.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Belum ada pilihan",
                Detail = "Ceklis minimal satu baris untuk disimpan.",
                Duration = 5000
            });
            return;
        }

        var confirm = await DialogService.Confirm(
            $"Simpan {chosen.Count} baris (tercentang) transaksi Pajak Keluaran ke database?",
            "Konfirmasi Add",
            new ConfirmOptions { OkButtonText = "Ya", CancelButtonText = "Batal" });
        if (confirm != true) return;

        _saving = true;
        var header = BuildHeader();
        var user = await CurrentUserAsync();   // -> kolom UserSign & Creator
        var (ok, err, docEntry, docNum) = await Task.Run(
            () => WebDb.SavePajakKeluaranAsync(header, chosen, user.Id, user.Name));
        _saving = false;

        if (!ok)
        {
            Notifications.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Gagal menyimpan",
                Detail = err ?? "Error.",
                Duration = 9000
            });
            return;
        }

        // Muat ulang grid setelah tersimpan; baris yang baru disimpan
        // (U_Status='Y' di SAP_WEB) otomatis ter-exclude dari hasil Load.
        await LoadData();

        // Pop up berhasil dengan tombol menuju halaman detail (ShowPajakKeluaran).
        ShowAddSuccess(docNum, docEntry);
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // Id & Fullname user yang sedang login (kolom UserSign & Creator di header).
    // Fullname dari claim "full_name"; fallback ke username bila kosong.
    private async Task<(int Id, string Name)> CurrentUserAsync()
    {
        if (AuthState is null) return (0, "");
        var state = await AuthState;
        var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var fullName = state.User.FindFirst("full_name")?.Value;
        var name = string.IsNullOrWhiteSpace(fullName)
            ? state.User.Identity?.Name ?? ""
            : fullName;
        return (int.TryParse(id, out var uid) ? uid : 0, name);
    }

    // Modal sukses Add: teks + tombol "Show" yang membuka detail dokumen.
    private void ShowAddSuccess(int docNum, int docEntry)
    {
        DialogService.Open("Berhasil", ds =>
    @<div class="text-center p-2">
        <p class="mb-3">
            Berhasil di tambahkan dengan Dokumen Transaksi <strong>@docNum</strong>
        </p>
        <RadzenButton Text="Show" Icon="visibility" ButtonStyle="Radzen.ButtonStyle.Primary"
                      Click="@(() => { ds.Close(); Nav.NavigateTo($"/efaktur/show-pajak-keluaran?doc={docEntry}"); })" />
    </div>
        , new DialogOptions { Width = "440px", ShowClose = true, CloseDialogOnOverlayClick = true });
    }

    private PajakKeluaranHeader BuildHeader()
    {
        var h = new PajakKeluaranHeader
        {
            Search = searchBy switch { "Invoice Number" => "N", "Date" => "D", "Customer" => "C", _ => "N" },
            Format = "0",
        };
        switch (searchBy)
        {
            case "Invoice Number":
                h.FromEntry = invFromDoc; h.ToEntry = invToDoc;
                h.FromNum = invFromNum;   h.ToNum = invToNum;
                break;
            case "Customer":
                h.FromEntry = custFromDoc; h.ToEntry = custToDoc;
                h.FromCust = custFromName; h.ToCust = custToName;
                break;
            case "Date":
                h.FromDate = ParseDdMmYy(fromDate); h.ToDate = ParseDdMmYy(toDate);
                break;
        }
        return h;
    }

    private static DateTime? ParseDdMmYy(string ddmmyy)
    {
        var d = new string((ddmmyy ?? "").Where(char.IsDigit).ToArray());
        if (d.Length != 6) return null;
        return DateTime.TryParseExact($"20{d[4..6]}-{d[2..4]}-{d[..2]}", "yyyy-MM-dd",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var dt) ? dt : null;
    }

    // Buka pop-up daftar invoice (OINV). Setelah Choose: tampilkan NumAtCard,
    // simpan DocEntry (hidden) sebagai parameter SP.
    private async Task OpenInvoiceModal(bool isFrom)
    {
        var result = await DialogService.OpenAsync<InvoiceNumberList>(
            "List of A/R Invoices", null,
            new Radzen.DialogOptions { Width = "760px", Height = "560px", CloseDialogOnOverlayClick = true });

        if (result is InvoiceListRow row)
        {
            if (isFrom) { invFromNum = row.NumAtCard ?? ""; invFromDoc = row.DocEntry.ToString(); }
            else        { invToNum = row.NumAtCard ?? "";   invToDoc = row.DocEntry.ToString(); }

            // Paksa render agar nilai baru langsung tampil di field.
            await InvokeAsync(StateHasChanged);
        }
    }

    // Buka pop-up daftar customer (OCRD). Setelah Choose: tampilkan CardName,
    // simpan DocEntry (hidden) sebagai parameter SP.
    private async Task OpenCustomerModal(bool isFrom)
    {
        var result = await DialogService.OpenAsync<CustomerList>(
            "List of Customers", null,
            new Radzen.DialogOptions { Width = "760px", Height = "560px", CloseDialogOnOverlayClick = true });

        if (result is CustomerListRow row)
        {
            if (isFrom) { custFromName = row.CardName ?? ""; custFromDoc = row.DocEntry.ToString(); }
            else        { custToName = row.CardName ?? "";   custToDoc = row.DocEntry.ToString(); }

            await InvokeAsync(StateHasChanged);
        }
    }

    // Filter tanggal (format dd.MM.yy), diisi via input bermask.
    private string fromDate = "";
    private string toDate = "";

    // Ubah ketikan angka jadi format dd.MM.yy, mis. "290126" -> "29.01.26".
    private static string FormatDateMask(string? raw)
    {
        var d = new string((raw ?? "").Where(char.IsDigit).ToArray());
        if (d.Length > 6) d = d[..6];
        return d.Length switch
        {
            <= 2 => d,
            <= 4 => d[..2] + "." + d[2..],
            _    => d[..2] + "." + d[2..4] + "." + d[4..]
        };
    }

    // "29.01.26" -> "2026-01-29" (untuk value datepicker native).
    private static string ToIso(string ddmmyy)
    {
        var d = new string((ddmmyy ?? "").Where(char.IsDigit).ToArray());
        return d.Length == 6 ? $"20{d[4..6]}-{d[2..4]}-{d[..2]}" : "";
    }

    // "2026-01-29" (dari datepicker) -> "29.01.26".
    private static string FromIso(string? iso)
    {
        if (!string.IsNullOrEmpty(iso) && DateTime.TryParse(iso, out var dt))
            return $"{dt:dd}.{dt:MM}.{dt:yy}";
        return "";
    }

    private async Task LoadData()
    {
        // From & To wajib diisi (sesuai jenis Search By).
        var (from, to) = searchBy switch
        {
            "Invoice Number" => (invFromDoc, invToDoc),
            "Date"           => (fromDate, toDate),
            "Customer"       => (custFromDoc, custToDoc),
            _                => (invFromDoc, invToDoc),
        };
        if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to))
        {
            _validationError = "Field From dan To wajib diisi.";
            result = null;
            _rows = new();
            _selected.Clear();
            return;
        }
        _validationError = null;

        loading = true;
        result = null;
        _rows = new();
        _selected.Clear();
        await Task.Yield();

        var filter = new PajakKeluaranFilter
        {
            SearchBy      = searchBy,
            InvoiceFrom   = invFromDoc,
            InvoiceTo     = invToDoc,
            DateFrom      = fromDate,
            DateTo        = toDate,
            CustomerFrom  = custFromDoc,
            CustomerTo    = custToDoc,
            Invoice       = dtInvoice,
            DownPayment   = dtDownPayment,
            RefCreditMemo = dtRefCreditMemo,
        };

        // Jalankan di thread pool agar driver DB yang memblokir tidak
        // membekukan UI/Nav Menu selama menunggu hasil SP.
        result = await Task.Run(() => FpService.LoadAsync(filter));

        if (result?.Error is null && result is not null)
        {
            _rows = MapRows(result);

            // Kecualikan invoice yang SUDAH difaktur (ada di IDU_PAJAK_TRANS_DET
            // SAP_WEB dengan U_Status='Y') — cocokkan DocEntry + tipe dokumen.
            var processed = await Task.Run(() => WebDb.GetProcessedInvoiceKeysAsync());
            if (processed.Count > 0)
                _rows = _rows.Where(r => !processed.Contains((r.DocEntry, r.ObjType.ToString()))).ToList();

            ComputeWidths();
        }

        loading = false;
    }

    // ── Lebar kolom otomatis (fit isi) ────────────────────────────────────────
    private readonly Dictionary<string, int> _colWidths = new();

    private static readonly Dictionary<string, System.Reflection.PropertyInfo> _props =
        typeof(FakturKeluaranRow).GetProperties()
            .ToDictionary(p => p.Name, p => p, StringComparer.OrdinalIgnoreCase);

    private void ComputeWidths()
    {
        _colWidths.Clear();
        foreach (var c in FakturKeluaranRow.Columns)
        {
            if (!c.Visible) continue;
            _props.TryGetValue(c.Property, out var pi);
            var maxData = (pi is null || _rows.Count == 0)
                ? 0
                : _rows.Max(r => FormatVal(pi.GetValue(r), c.Kind).Length);
            var chars = Math.Max(c.Title.Length + 2, maxData);
            _colWidths[c.Property] = Math.Clamp(chars * 8 + 26, 90, 320);
        }
    }

    private string WidthOf(string prop) => (_colWidths.TryGetValue(prop, out var w) ? w : 140) + "px";

    private static string? FormatOf(ColKind kind) => kind switch
    {
        ColKind.Money => "{0:#,##0.00}",
        ColKind.Date  => "{0:dd.MM.yyyy}",
        _             => null,
    };

    // Nilai terformat (sesuai FormatOf) untuk mengukur panjang teks kolom.
    private static string FormatVal(object? v, ColKind kind) => v switch
    {
        null => "",
        DateTime dt when kind == ColKind.Date => dt.ToString("dd.MM.yyyy"),
        decimal d when kind == ColKind.Money => d.ToString("#,##0.00"),
        _ => v.ToString() ?? "",
    };

    // Petakan hasil SP (kolom dinamis) ke model bertipe berdasar nama kolom.
    private static List<FakturKeluaranRow> MapRows(QueryResult r)
    {
        var idx = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        for (var i = 0; i < r.Columns.Count; i++) idx[r.Columns[i]] = i;

        object? Get(object?[] row, string col) => idx.TryGetValue(col, out var i) && i < row.Length ? row[i] : null;
        string? Str(object?[] row, string col) => Get(row, col)?.ToString();
        int Int(object?[] row, string col) => Get(row, col) is { } v ? Convert.ToInt32(v) : 0;
        decimal Dec(object?[] row, string col) => Get(row, col) is { } v ? Convert.ToDecimal(v) : 0m;
        DateTime? Date(object?[] row, string col) => Get(row, col) switch
        {
            DateTime dt => dt,
            { } v when DateTime.TryParse(v.ToString(), out var d) => d,
            _ => null,
        };

        var list = new List<FakturKeluaranRow>(r.Rows.Count);
        foreach (var row in r.Rows)
        {
            list.Add(new FakturKeluaranRow
            {
                DocEntry   = Int(row, "DocEntry"),
                DocNum     = Int(row, "DocNum"),
                DocDate    = Date(row, "DocDate"),
                CardEntry  = Int(row, "CardEntry"),
                CardCode   = Str(row, "CardCode"),
                CardName   = Str(row, "CardName"),
                DocTotal   = Dec(row, "DocTotal"),
                VatSum     = Dec(row, "VatSum"),
                ObjType    = Int(row, "ObjType"),
                ObjName    = Str(row, "ObjName"),
                NoFP       = Str(row, "NoFP"),
