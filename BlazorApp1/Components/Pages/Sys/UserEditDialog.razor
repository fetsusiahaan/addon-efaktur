@using BlazorApp1.Models
@using BlazorApp1.Services
@inject Radzen.DialogService DialogService
@inject DbManagerService DbMgr
@inject UserService Users

<div class="ued">
    <div class="row g-3">
        <div class="col-12">
            <label class="ued-label">Full Name <span class="ued-req">*</span></label>
            <input class="form-control" @bind="_u.FullName" placeholder="Nama lengkap" />
        </div>
        <div class="col-md-6">
            <label class="ued-label">Email <span class="ued-req">*</span></label>
            <input class="form-control" type="email" @bind="_u.Email" placeholder="email@contoh.com" />
        </div>
        <div class="col-md-6">
            <label class="ued-label">Username <span class="ued-req">*</span></label>
            <input class="form-control" @bind="_u.Username" placeholder="username"
                   disabled="@_isEdit" readonly="@_isEdit" />
            @if (_isEdit)
            {
                <small class="text-muted">Username tidak dapat diubah.</small>
            }
        </div>
        <div class="col-md-6">
            <label class="ued-label">Status</label>
            <select class="form-select" @bind="_u.Status">
                @foreach (var s in Statuses)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="ued-label">Role</label>
            <select class="form-select" @bind="_u.Role">
                @foreach (var r in Roles)
                {
                    <option value="@r">@r</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="ued-label">Joined Date</label>
            <input class="form-control" type="date" @bind="_u.JoinedDate" />
        </div>
        <div class="col-md-6">
            <label class="ued-label">Koneksi DB</label>
            <select class="form-select" @bind="_u.KoneksiDb">
                <option value="">— tidak ada —</option>
                @foreach (var c in _connections)
                {
                    <option value="@c.Nama">@c.Nama (@c.JenisDb)</option>
                }
            </select>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger py-2 mt-3 mb-0">@_error</div>
    }

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button class="btn btn-light" @onclick="Cancel">Batal</button>
        <button class="btn ued-save" @onclick="Save">
            <i class="bi bi-floppy me-1"></i>Simpan
        </button>
    </div>
</div>

@code {
    [Parameter] public AppUser? User { get; set; }

    private AppUser _u = new();
    private string? _error;
    private bool _isEdit;
    private List<DbConnectionEntry> _connections = new();

    private static readonly string[] Statuses = { "Active", "Inactive", "Banned", "Pending", "Suspended" };
    private static readonly string[] Roles = { "Admin", "User", "Guest", "Moderator" };

    protected override void OnInitialized()
    {
        _connections = DbMgr.GetAll();
        _isEdit = User is not null && User.Id != 0;

        _u = User is null
            ? new AppUser { JoinedDate = DateTime.Today }   // Password default "Password#01" dari model
            : new AppUser
            {
                Id = User.Id, FullName = User.FullName, Email = User.Email, Username = User.Username,
                Status = User.Status, Role = User.Role, JoinedDate = User.JoinedDate,
                LastActive = User.LastActive, KoneksiDb = User.KoneksiDb, Password = User.Password
            };
    }

    private void Save()
    {
        _u.FullName = _u.FullName?.Trim() ?? "";
        _u.Email = _u.Email?.Trim() ?? "";
        _u.Username = _u.Username?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(_u.FullName)) { _error = "Full Name wajib diisi."; return; }
        if (string.IsNullOrWhiteSpace(_u.Username)) { _error = "Username wajib diisi."; return; }
        if (string.IsNullOrWhiteSpace(_u.Email)) { _error = "Email wajib diisi."; return; }
        if (!new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(_u.Email))
        {
            _error = "Format email tidak valid."; return;
        }

        // Username harus unik (hanya relevan saat Add — saat edit username terkunci).
        if (!_isEdit && Users.UsernameExists(_u.Username))
        {
            _error = "Username sudah digunakan"; return;
        }

        if (_u.Id == 0) _u.LastActive = DateTime.Now;
        DialogService.Close(_u);
    }

    private void Cancel() => DialogService.Close(null);
}
