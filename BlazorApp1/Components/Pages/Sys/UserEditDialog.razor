@using BlazorApp1.Models
@using BlazorApp1.Services
@inject Radzen.DialogService DialogService
@inject DbManagerService DbMgr
@inject UserService Users

<div class="ued">
    <div class="row g-3">
        <div class="col-12">
            <label class="ued-label">Full Name <span class="ued-req">*</span></label>
            <input class="form-control" @bind="_u.FullName" placeholder="Nama lengkap" />
        </div>
        <div class="col-md-6">
            <label class="ued-label">Email <span class="ued-req">*</span></label>
            <input class="form-control" type="email" @bind="_u.Email" placeholder="email@contoh.com" />
        </div>
        <div class="col-md-6">
            <label class="ued-label">Username <span class="ued-req">*</span></label>
            <input class="form-control" value="@_u.Username" @oninput="OnUsernameInput" placeholder="username"
                   disabled="@_isEdit" readonly="@_isEdit"
                   onkeypress="filterUsernameKey(event)" onpaste="sanitizeUsernamePaste(event)" />
            @if (_isEdit)
            {
                <small class="text-muted">Username tidak dapat diubah.</small>
            }
        </div>
        @if (!_isEdit)
        {
            <div class="col-md-6">
                <label class="ued-label">Password <span class="ued-req">*</span></label>
                <div class="ued-pwd-input">
                    <input class="form-control" type="password" @bind="_u.Password" placeholder="Password" />
                    <button type="button" class="ued-eye" tabindex="-1" aria-label="Lihat / sembunyikan password"
                            onclick="togglePwd(this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <small class="text-muted">Min. 8 karakter, kombinasi huruf besar, huruf kecil, angka, simbol.</small>
            </div>
            <div class="col-md-6">
                <label class="ued-label">Konfirmasi Password <span class="ued-req">*</span></label>
                <div class="ued-pwd-input">
                    <input class="form-control" type="password" @bind="_confirmPassword" placeholder="Ulangi password" />
                    <button type="button" class="ued-eye" tabindex="-1" aria-label="Lihat / sembunyikan password"
                            onclick="togglePwd(this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="uedChangePwd" @bind="_changePassword" />
                    <label class="form-check-label ued-label mb-0" for="uedChangePwd">Ganti Password</label>
                </div>
            </div>
            @if (_changePassword)
            {
                <div class="col-md-6">
                    <label class="ued-label">Password Baru <span class="ued-req">*</span></label>
                    <div class="ued-pwd-input">
                        <input class="form-control" type="password" @bind="_u.Password" placeholder="Password baru" />
                        <button type="button" class="ued-eye" tabindex="-1" aria-label="Lihat / sembunyikan password"
                                onclick="togglePwd(this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <small class="text-muted">Min. 8 karakter, kombinasi huruf besar, huruf kecil, angka, simbol.</small>
                </div>
                <div class="col-md-6">
                    <label class="ued-label">Konfirmasi Password Baru <span class="ued-req">*</span></label>
                    <div class="ued-pwd-input">
                        <input class="form-control" type="password" @bind="_confirmPassword" placeholder="Ulangi password baru" />
                        <button type="button" class="ued-eye" tabindex="-1" aria-label="Lihat / sembunyikan password"
                                onclick="togglePwd(this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>
            }
        }
        <div class="col-md-6">
            <label class="ued-label">Status</label>
            <select class="form-select" @bind="_u.Status">
                @foreach (var s in Statuses)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="ued-label">Role</label>
            <select class="form-select" @bind="_u.Role">
                @foreach (var r in Roles)
                {
                    <option value="@r">@r</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="ued-label">Joined Date</label>
            <input class="form-control" type="date" @bind="_u.JoinedDate" />
        </div>
        <div class="col-md-6">
            <label class="ued-label">Koneksi DB</label>
            <select class="form-select" @bind="_u.KoneksiDb">
                <option value="">— tidak ada —</option>
                @foreach (var c in _connections)
                {
                    <option value="@c.Nama">@c.Nama (@c.JenisDb)</option>
                }
            </select>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger py-2 mt-3 mb-0">@_error</div>
    }

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button class="btn btn-light" @onclick="Cancel">Batal</button>
        <button class="btn ued-save" @onclick="Save">
            <i class="bi bi-floppy me-1"></i>Simpan
        </button>
    </div>
</div>

@code {
    [Parameter] public AppUser? User { get; set; }

    private AppUser _u = new();
    private string _confirmPassword = "";
    private string? _error;
    private bool _isEdit;
    private bool _changePassword;
    private List<DbConnectionEntry> _connections = new();

    private static readonly string[] Statuses = { "Active", "Inactive", "Banned", "Pending", "Suspended" };
    private static readonly string[] Roles = { "Admin", "User" };

    protected override void OnInitialized()
    {
        _connections = DbMgr.GetAll();
        _isEdit = User is not null && User.Id != 0;

        _u = User is null
            ? new AppUser { JoinedDate = DateTime.Today, Password = "" }
            : new AppUser
            {
                Id = User.Id, FullName = User.FullName, Email = User.Email, Username = User.Username,
                Status = User.Status, Role = User.Role, JoinedDate = User.JoinedDate,
                LastActive = User.LastActive, KoneksiDb = User.KoneksiDb, Password = ""
            };
    }

    private void Save()
    {
        _u.FullName = _u.FullName?.Trim() ?? "";
        _u.Email = _u.Email?.Trim() ?? "";
        _u.Username = _u.Username?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(_u.FullName)) { _error = "Full Name wajib diisi."; return; }
        if (string.IsNullOrWhiteSpace(_u.Username)) { _error = "Username wajib diisi."; return; }
        if (_u.Username != SanitizeUsername(_u.Username)) { _error = "Username hanya boleh huruf kecil dan angka."; return; }
        if (string.IsNullOrWhiteSpace(_u.Email)) { _error = "Email wajib diisi."; return; }
        if (!new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(_u.Email))
        {
            _error = "Format email tidak valid."; return;
        }

        // Username harus unik (hanya relevan saat Add — saat edit username terkunci).
        if (!_isEdit && Users.UsernameExists(_u.Username))
        {
            _error = "Username sudah digunakan"; return;
        }

        if (!_isEdit)
        {
            if (string.IsNullOrWhiteSpace(_u.Password)) { _error = "Password wajib diisi."; return; }
            if (!IsPasswordStrong(_u.Password, out var pwErr)) { _error = pwErr; return; }
            if (_u.Password != _confirmPassword) { _error = "Konfirmasi Password tidak cocok."; return; }
        }
        else if (_changePassword)
        {
            if (string.IsNullOrWhiteSpace(_u.Password)) { _error = "Password baru wajib diisi."; return; }
            if (!IsPasswordStrong(_u.Password, out var pwErr)) { _error = pwErr; return; }
            if (_u.Password != _confirmPassword) { _error = "Konfirmasi Password tidak cocok."; return; }
        }
        else
        {
            // Edit tanpa ganti password: kosongkan agar Update() tidak menyentuh kolom Password.
            _u.Password = "";
        }

        if (_u.Id == 0) _u.LastActive = DateTime.Now;
        DialogService.Close(_u);
    }

    private void Cancel() => DialogService.Close(null);

    private void OnUsernameInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
        => _u.Username = SanitizeUsername(e.Value?.ToString());

    // Hanya huruf kecil dan angka — tanpa spasi/simbol lain.
    private static string SanitizeUsername(string? raw)
    {
        if (string.IsNullOrEmpty(raw)) return "";
        var sb = new System.Text.StringBuilder(raw.Length);
        foreach (var c in raw.ToLowerInvariant())
        {
            if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))
                sb.Append(c);
        }
        return sb.ToString();
    }

    // Min 8 char, kombinasi huruf besar, huruf kecil, angka, simbol.
    private static bool IsPasswordStrong(string pw, out string? error)
    {
        error = null;
        if (pw.Length < 8) { error = "Password minimal 8 karakter."; return false; }
        if (!pw.Any(char.IsUpper)) { error = "Password harus mengandung huruf besar."; return false; }
        if (!pw.Any(char.IsLower)) { error = "Password harus mengandung huruf kecil."; return false; }
        if (!pw.Any(char.IsDigit)) { error = "Password harus mengandung angka."; return false; }
        if (!pw.Any(c => !char.IsLetterOrDigit(c))) { error = "Password harus mengandung simbol."; return false; }
        return true;
    }
}
