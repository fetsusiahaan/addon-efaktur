@page "/sys/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using System.Text
@using BlazorApp1.Models
@using BlazorApp1.Services
@inject UserService Users
@inject Radzen.DialogService DialogService
@inject IJSRuntime JS

<PageTitle>User Management</PageTitle>

<div class="um-page">

    <PageHeader Title="User Management" Breadcrumb="System › Administration" />

    <div class="um-card">

        @* ---------- Toolbar ---------- *@
        <div class="um-toolbar">
            <div class="um-search">
                <i class="bi bi-search"></i>
                <input placeholder="Search" value="@_search" @oninput="OnSearch" />
            </div>

            <select class="um-filter" @bind="_role" @bind:after="ResetPage">
                <option value="">Role</option>
                @foreach (var r in RoleOptions) { <option value="@r">@r</option> }
            </select>

            <select class="um-filter" @bind="_status" @bind:after="ResetPage">
                <option value="">Status</option>
                @foreach (var s in StatusOptions) { <option value="@s">@s</option> }
            </select>

            <select class="um-filter" @bind="_dateRange" @bind:after="ResetPage">
                <option value="">Date</option>
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="365">Last year</option>
            </select>

            <div class="um-toolbar-right">
                <button class="um-btn-ghost" @onclick="ExportCsv"><i class="bi bi-box-arrow-up me-1"></i>Export</button>
                <button class="um-btn-primary" @onclick="() => OpenEditor(null)"><i class="bi bi-plus-lg me-1"></i>Add User</button>
            </div>
        </div>

        @* ---------- Grid ---------- *@
        @* Paging ditangani manual (lihat .um-pager di bawah) supaya kontrol
           "items per page" bisa custom & posisinya presisi meski ada CSS zoom. *@
        <RadzenDataGrid Data="@Paged" TItem="AppUser" AllowPaging="false" AllowSorting="true"
                        Style="height: 68vh; --rz-grid-header-background-color:#1f2d3d; --rz-grid-header-color:#fff;">
            <Columns>
                <RadzenDataGridColumn TItem="AppUser" Width="46px" Sortable="false" TextAlign="Radzen.TextAlign.Center">
                    <HeaderTemplate>
                        <input type="checkbox" checked="@AllSelected" @onchange="e => ToggleAll((bool)e.Value!)" />
                    </HeaderTemplate>
                    <Template Context="u">
                        <input type="checkbox" checked="@_selected.Contains(u.Id)" @onchange="e => ToggleOne(u.Id, (bool)e.Value!)" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="AppUser" Property="FullName" Title="Full Name" Width="210px">
                    <Template Context="u">
                        <div class="um-user">
                            <span class="um-avatar" style="background:@u.AvatarColor">@u.Initials</span>
                            <span>@u.FullName</span>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="AppUser" Property="Username" Title="Username" Width="140px" />

                <RadzenDataGridColumn TItem="AppUser" Property="Status" Title="Status" Width="130px">
                    <Template Context="u"><span class="um-badge um-@u.Status.ToLowerInvariant()">@u.Status</span></Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="AppUser" Property="Role" Title="Role" Width="120px" />

                <RadzenDataGridColumn TItem="AppUser" Property="KoneksiDb" Title="Koneksi DB" Width="150px">
                    <Template Context="u">@(string.IsNullOrEmpty(u.KoneksiDb) ? "—" : u.KoneksiDb)</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="AppUser" Title="Actions" Sortable="false" Width="120px" TextAlign="Radzen.TextAlign.Center">
                    <Template Context="u">
                        <button class="um-icon" title="Detail" @onclick="() => ShowDetail(u)"><i class="bi bi-eye"></i></button>
                        <button class="um-icon" title="Edit" @onclick="() => OpenEditor(u)"><i class="bi bi-pencil"></i></button>
                        <button class="um-icon um-icon-danger" title="Hapus" @onclick="() => DeleteUser(u)"><i class="bi bi-trash3"></i></button>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @* ---------- Pager custom ---------- *@
        <div class="um-pager">
            <span class="um-pager-summary">of @TotalRows rows</span>

            <div class="um-pager-nav">
                <button type="button" class="um-page-btn" title="Halaman pertama"
                        disabled="@(_pageIndex == 0)" @onclick="() => GoTo(0)">
                    <i class="bi bi-chevron-bar-left"></i>
                </button>
                <button type="button" class="um-page-btn" title="Sebelumnya"
                        disabled="@(_pageIndex == 0)" @onclick="() => GoTo(_pageIndex - 1)">
                    <i class="bi bi-chevron-left"></i>
                </button>

                @foreach (var p in PageNumbers)
                {
                    <button type="button" class="um-page-btn um-page-num @(p == _pageIndex ? "active" : "")"
                            @onclick="() => GoTo(p)">@(p + 1)</button>
                }

                <button type="button" class="um-page-btn" title="Berikutnya"
                        disabled="@(_pageIndex >= PageCount - 1)" @onclick="() => GoTo(_pageIndex + 1)">
                    <i class="bi bi-chevron-right"></i>
                </button>
                <button type="button" class="um-page-btn" title="Halaman terakhir"
                        disabled="@(_pageIndex >= PageCount - 1)" @onclick="() => GoTo(PageCount - 1)">
                    <i class="bi bi-chevron-bar-right"></i>
                </button>
            </div>

            @* Dropdown custom: menu dibuka KE ATAS, diposisikan relatif ke
               kontainernya (bukan di-append ke body) -> presisi meski ada zoom. *@
            <div class="um-ps @(_pageSizeOpen ? "open" : "")">
                @if (_pageSizeOpen)
                {
                    <div class="um-ps-backdrop" @onclick="() => _pageSizeOpen = false"></div>
                    <div class="um-ps-menu">
                        @foreach (var n in _pageSizes)
                        {
                            <button type="button" class="um-ps-item @(n == _pageSize ? "active" : "")"
                                    @onclick="() => SelectPageSize(n)">@n</button>
                        }
                    </div>
                }
                <button type="button" class="um-ps-btn" @onclick="TogglePageSize">
                    <span>@_pageSize</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <span class="um-pager-label">items per page</span>
        </div>
    </div>
</div>

@code {
    private List<AppUser> _all = new();
    private readonly HashSet<int> _selected = new();
    private readonly int[] _pageSizes = { 10, 20, 50 };
    private int _pageSize = 10;
    private int _pageIndex;
    private bool _pageSizeOpen;

    // ── Paging manual ───────────────────────────────────────────────────────
    private int TotalRows => Filtered.Count();
    private int PageCount => Math.Max(1, (int)Math.Ceiling(TotalRows / (double)_pageSize));

    // Baris untuk halaman aktif; index di-clamp agar aman saat filter menyusut.
    private IEnumerable<AppUser> Paged
    {
        get
        {
            if (_pageIndex > PageCount - 1) _pageIndex = PageCount - 1;
            return Filtered.Skip(_pageIndex * _pageSize).Take(_pageSize);
        }
    }

    // Jendela maksimal 5 nomor halaman di sekitar halaman aktif.
    private IEnumerable<int> PageNumbers
    {
        get
        {
            var count = PageCount;
            var start = Math.Max(0, Math.Min(_pageIndex - 2, count - 5));
            for (var i = start; i < Math.Min(count, start + 5); i++) yield return i;
        }
    }

    private void GoTo(int p) => _pageIndex = Math.Clamp(p, 0, PageCount - 1);
    private void ResetPage() => _pageIndex = 0;

    private void TogglePageSize() => _pageSizeOpen = !_pageSizeOpen;
    private void SelectPageSize(int n) { _pageSize = n; _pageSizeOpen = false; _pageIndex = 0; }

    private string _search = "";
    private string _role = "";
    private string _status = "";
    private string _dateRange = "";

    private static readonly string[] RoleOptions = { "Admin", "User", "Guest", "Moderator" };
    private static readonly string[] StatusOptions = { "Active", "Inactive", "Banned", "Pending", "Suspended" };

    protected override void OnInitialized() => _all = Users.GetAll();

    private IEnumerable<AppUser> Filtered
    {
        get
        {
            IEnumerable<AppUser> q = _all;

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(u =>
                    u.FullName.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    u.Email.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    u.Username.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrEmpty(_role)) q = q.Where(u => u.Role == _role);
            if (!string.IsNullOrEmpty(_status)) q = q.Where(u => u.Status == _status);
            if (int.TryParse(_dateRange, out var days))
            {
                var cut = DateTime.Now.AddDays(-days);
                q = q.Where(u => u.JoinedDate >= cut);
            }
            return q.ToList();
        }
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        ResetPage();
    }

    // ── Seleksi ─────────────────────────────────────────────────────────────
    private bool AllSelected => Filtered.Any() && Filtered.All(u => _selected.Contains(u.Id));
    private void ToggleAll(bool v)
    {
        if (v) foreach (var u in Filtered) _selected.Add(u.Id);
        else _selected.Clear();
    }
    private void ToggleOne(int id, bool v) { if (v) _selected.Add(id); else _selected.Remove(id); }

    // ── Add / Edit / Delete ─────────────────────────────────────────────────
    private async Task OpenEditor(AppUser? u)
    {
        var result = await DialogService.OpenAsync<UserEditDialog>(
            u is null ? "Tambah User" : "Edit User",
            new Dictionary<string, object?> { ["User"] = u },
            new Radzen.DialogOptions { Width = "560px", CloseDialogOnOverlayClick = true });

        if (result is AppUser edited)
        {
            if (edited.Id == 0) Users.Add(edited); else Users.Update(edited);
            _all = Users.GetAll();
        }
    }

    private async Task DeleteUser(AppUser u)
    {
        var ok = await DialogService.Confirm(
            $"Hapus user '{u.FullName}'?", "Konfirmasi Hapus",
            new Radzen.ConfirmOptions { OkButtonText = "Hapus", CancelButtonText = "Batal" });

        if (ok == true)
        {
            Users.Delete(u.Id);
            _selected.Remove(u.Id);
            _all = Users.GetAll();
        }
    }

    // ── Detail ──────────────────────────────────────────────────────────────
    private async Task ShowDetail(AppUser u) =>
        await DialogService.OpenAsync<UserDetailDialog>(
            "Detail User",
            new Dictionary<string, object?> { ["User"] = u },
            new Radzen.DialogOptions { Width = "520px", CloseDialogOnOverlayClick = true });

    // ── Export ──────────────────────────────────────────────────────────────
    private async Task ExportCsv()
    {
        // Jika ada baris tercentang -> export yang dicentang saja.
        // Jika tidak ada -> export semua (mengikuti filter aktif).
        var rows = _selected.Count > 0
            ? _all.Where(u => _selected.Contains(u.Id))
            : Filtered;

        var sb = new StringBuilder();
        sb.AppendLine("FullName,Email,Username,Status,Role,JoinedDate,LastActive");
        foreach (var u in rows)
            sb.AppendLine($"\"{u.FullName}\",\"{u.Email}\",\"{u.Username}\",{u.Status},{u.Role}," +
                          $"{u.JoinedDate:yyyy-MM-dd},{u.LastActive:yyyy-MM-dd HH:mm}");

        await JS.InvokeVoidAsync("downloadFile", $"users-{DateTime.Now:yyyyMMddHHmm}.csv", sb.ToString(), "text/csv");
    }
}
