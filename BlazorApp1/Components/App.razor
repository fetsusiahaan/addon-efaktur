<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/material-base.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="BlazorApp1.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script>
        // Toggle sidebar + simpan state (localStorage) agar konsisten di semua halaman.
        window.toggleSidebar = () => {
            const on = document.documentElement.classList.toggle('sidebar-hidden');
            try { localStorage.setItem('sidebarHidden', on ? '1' : '0'); } catch (e) { }
        };
        (function () {
            function applySidebar() {
                let hidden = false;
                try { hidden = localStorage.getItem('sidebarHidden') === '1'; } catch (e) { }
                document.documentElement.classList.toggle('sidebar-hidden', hidden);
            }
            applySidebar();
            // Terapkan ulang setelah navigasi (enhanced load) & saat halaman siap.
            window.addEventListener('load', function () {
                applySidebar();
                if (window.Blazor && Blazor.addEventListener) {
                    try { Blazor.addEventListener('enhancedload', applySidebar); } catch (e) { }
                }
            });
        })();

        window.togglePwd = (btn) => {
            const input = btn.parentElement.querySelector('input');
            const icon = btn.querySelector('i');
            if (!input) return;
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        };

        window.downloadFile = (filename, content, mime) => {
            const blob = new Blob([content], { type: mime });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };
    </script>
</body>

</html>
