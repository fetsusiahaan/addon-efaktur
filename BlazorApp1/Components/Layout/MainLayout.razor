@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <DbStatus />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@* Host dialog/notifikasi/tooltip Radzen — di root layout (di luar top-row)
   agar tidak terkurung stacking context & selalu di atas grid. *@
<RadzenComponents @rendermode="InteractiveServer" />
